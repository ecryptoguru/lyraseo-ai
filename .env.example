# Local development uses synthetic examples until services are explicitly configured.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Explicit opt-in; leave disabled until the private-pilot auth runbook is verified.
# LYRA_AUTH_ENABLED=false
# APP_ORIGIN=http://127.0.0.1:3000
# PILOT_ALLOWED_EMAILS=
# AUTH_DATABASE_URL=
# DATABASE_URL=
# DIRECT_URL=
# Local controlled raw audits require configured private authentication and verified sites.
# LYRA_LOCAL_RAW_AUDITS=false
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_SOL_DEPLOYMENT=
# AZURE_LUNA_DEPLOYMENT=
# PARALLEL_API_KEY=
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# GMAIL_SMTP_USER=
# GMAIL_SMTP_APP_PASSWORD=

# GSC readonly integration; disabled until all three server secrets are configured.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# INTEGRATION_ENCRYPTION_KEY= # canonical base64 of 32 cryptographically random bytes

# Server-only rollout: default off. Exact comma-separated names only.
# audits,context,search,analytics,content,visibility,mcp
# Saved authorized evidence and cancel/disconnect/revoke remain accessible while paused.
# This does not qualify providers or bypass local raw-audit/hosting/tariff gates.
LYRA_ENABLED_CAPABILITIES=
