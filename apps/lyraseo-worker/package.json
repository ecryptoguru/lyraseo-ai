{
  "name": "@lyraseo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "generate-types": "wrangler types --env local --strict-vars false",
    "test": "vitest run --config vitest.config.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" vitest.config.ts wrangler.jsonc package.json tsconfig.json ../../scripts/test-worker-bridge.mjs ../../scripts/lib/worker-test-mapper.mjs ../../tests/worker-harness.test.mjs"
  },
  "dependencies": {
    "@lyraseo/contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "4.156.2",
    "@cloudflare/vitest-plugin": "1.5.0",
    "vitest": "4.1.12"
  }
}
