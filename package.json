{
  "name": "lyraseo-ai",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "pnpm --filter @lyraseo/web dev",
    "build": "pnpm --filter @lyraseo/web build",
    "check": "pnpm --filter @lyraseo/web lint && pnpm -r typecheck",
    "test:unit": "vitest run tests/unit",
    "test:crawler": "vitest run tests/crawler",
    "test:integration": "vitest run tests/integration",
    "test:legacy-visibility-retention": "node scripts/test-legacy-visibility-retention.mjs",
    "test:legacy-inline": "node scripts/test-legacy-inline.mjs",
    "test:legacy-report-role-isolation": "node scripts/test-legacy-report-role-isolation.mjs",
    "test:legacy-report-review": "node scripts/test-legacy-report-review.mjs",
    "test:legacy-reports": "node scripts/test-legacy-reports.mjs",
    "test:private-artifact-expiry": "node scripts/test-private-artifact-expiry.mjs",
    "test:migrations": "node scripts/test-migrations.mjs",
    "test:e2e": "pnpm --filter @lyraseo/web test:e2e",
    "db:local": "node scripts/local-db.mjs",
    "format:check": "prettier --check \"apps/lyraseo-web/src/**/*.{ts,tsx,css}\" \"packages/*/src/*.ts\" \"tests/**/*.ts\" && pnpm --filter @lyraseo/worker format:check",
    "auth:preflight": "node --env-file-if-exists=apps/lyraseo-web/.env.local scripts/auth-preflight.mjs",
    "test:worker": "node --test tests/worker-harness.test.mjs && node scripts/test-worker-bridge.mjs",
    "test:handoffs": "node scripts/test-handoffs.mjs",
    "test:handoff-dispatch": "node scripts/test-handoff-retirement-fence.mjs",
    "test:handoff-carrier": "node scripts/test-handoff-carrier.mjs",
    "test:observation-adapters": "node scripts/test-observation-adapters.mjs",
    "test:provider-ledger": "node scripts/test-provider-ledger.mjs",
    "test:sandbox-billing": "node scripts/test-sandbox-billing.mjs",
    "test:staff-action-replay": "node scripts/test-staff-action-replay.mjs",
    "test:staff-job-review": "node --test tests/staff-job-gate.test.mjs && node scripts/test-staff-job-review.mjs",
    "test:history-retention": "node scripts/test-history-retention.mjs",
    "test:full-backup": "node scripts/test-full-backup.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@modelcontextprotocol/client": "2.4.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
