 userId String
 sessionId String
 securityVersion Int
 verifier String
 expiresAt DateTime
 consumedAt DateTime?
 site Site @relation(fields:[workspaceId,siteId],references:[workspaceId,id],onDelete:Cascade)
 @@index([workspaceId,siteId])
}
model AnalyticsConnection {
 id String @id @default(cuid())
 workspaceId String
 siteId String @unique
 encryptedRefreshToken String
 property String?
 streamId String?
 timeZone String?
 status String @default("connected")
 catalog Json @default("[]")
 generation Int @default(0)
 createdAt DateTime @default(now())
 site Site @relation(fields:[workspaceId,siteId],references:[workspaceId,id],onDelete:Cascade)
 @@unique([workspaceId,siteId])
}
model AnalyticsImport {
 resultExpiresAt DateTime? @default(dbgenerated())
 @@index([workspaceId,siteId,resultExpiresAt])
 id String @id
 workspaceId String
 siteId String
 property String
 streamId String
 timeZone String
 origin String
 startDate String
 endDate String
 shape String
 generation Int
 status String
 failure String?
 rows Json @default("[]")
 diagnostics Json @default("{}")
 startedAt DateTime @default(now())
