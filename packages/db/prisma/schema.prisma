 @@index([workspaceId,siteId,startedAt])
}

model SearchImport {
 resultExpiresAt DateTime @default(dbgenerated())
 @@index([workspaceId,siteId,resultExpiresAt])
 id String @id
 workspaceId String
 siteId String
 property String
 startDate String
 endDate String
 shape String
 generation Int
 status String
 attempt String
 leaseUntil DateTime
 failure String?
 startedAt DateTime @default(now())
 completedAt DateTime?
 site Site @relation(fields:[workspaceId,siteId],references:[workspaceId,id],onDelete:Cascade)
 @@index([workspaceId,siteId,status])
}

model RuntimePolicy {
  key String @id
  enabled Boolean @default(false)
  revision Int @default(0)
  changedAt DateTime @default(now()) @db.Timestamptz(6)
  changes RuntimePolicyChange[]
}
model RuntimePolicyChange {
  key String
  revision Int
  enabled Boolean
  operatorId String
  changedAt DateTime @db.Timestamptz(6)
  policy RuntimePolicy @relation(fields:[key],references:[key],onDelete:NoAction,onUpdate:NoAction)
  @@id([key,revision])
}
model WorkDispatch {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String
  siteId String
  userId String
  admittedSecurityVersion Int
  initiatedSessionId String?
  targetKind String
  operationId String? @unique
  auditId String? @unique
  archiveId String? @unique
  capability String
  profile String
  eligibility String
  ledgerHandoff String @default("NONE")
  admittedAt DateTime @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  disposition String
  generation Int @default(1)
  nextAttemptAt DateTime? @db.Timestamptz(6)
  deliveredAt DateTime? @db.Timestamptz(6)
  claimToken String? @db.Uuid
  leaseUntil DateTime? @db.Timestamptz(6)
  sendAttempts Int @default(0)
  lastErrorCode String?
  audit AuditRun? @relation(fields:[workspaceId,siteId,userId,auditId],references:[workspaceId,siteId,userId,id],onDelete:Restrict,onUpdate:Restrict)
  operation Operation? @relation(fields:[workspaceId,siteId,userId,operationId],references:[workspaceId,siteId,userId,id],onDelete:Restrict,onUpdate:Restrict)
  archive OutboxEvent? @relation(fields:[archiveId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  @@index([workspaceId,siteId,userId],map:"dispatch_scope")
}
model InternalRequest {
  servicePrincipalId String
  requestId String @db.Uuid
  fingerprint Bytes
  issuedAt DateTime @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  state String
  ownerToken String? @db.Uuid
  fence Int
  leaseUntil DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  result Json?
  @@id([servicePrincipalId,requestId])
  @@index([expiresAt,requestId],map:"request_cleanup")
}

model AuditPageRetention {
 artifactRefs ArtifactRef[]
 scratch AuditEvaluationScratch?
 pageId String @id
 workspaceId String
 auditId String
 capturedAt DateTime?
 rawExpiresAt DateTime?
 clockStatus String
 page AuditPage @relation(fields:[workspaceId,auditId,pageId],references:[workspaceId,auditId,id],onDelete:Cascade)
 @@unique([workspaceId,auditId,pageId])
 @@index([workspaceId,auditId,rawExpiresAt])
}
model ContentRevisionPin {
 workspaceId String
 draftId String
 revision Int
 pinnedAt DateTime @default(now())
 pinnedBy String
 pinner ProductUser @relation(fields:[pinnedBy], references:[id], onDelete:NoAction, onUpdate:NoAction)
 entry ContentRevision @relation(fields:[workspaceId,draftId,revision],references:[workspaceId,draftId,revision],onDelete:Cascade)
 @@id([workspaceId,draftId,revision])
}

model ArtifactBlob {
  ownerKind String @default("AUDIT_PAGE")
  recordingId String? @db.Uuid
  runId String?
  panelId String?
  promptId String?
  @@unique([workspaceId,siteId,panelId,runId,recordingId,promptId,id,generation,capturedAt,expiresAt])
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String
  siteId         String
  auditId        String?
  requestedUrl   String?
  pageId         String?      @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fence          Int?
  workId         String?      @db.Uuid
  workGeneration Int?
  category       String       @default("AUDIT_SOURCE")
  rights         String       @default("PRIVATE_AUDIT")
  expiryClass    String       @default("CAPTURE_30D")
  capturedAt     DateTime
  expiresAt      DateTime
  pendingReceipt Json?
  factHash       String
  storageKey     String       @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  generation     String       @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codec          String       @default("IDENTITY")
  sourceHash     String
  sourceLength   Int
  storedHash     String
  storedLength   Int
  state          String       @default("STAGED")
  createdAt      DateTime     @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  audit AuditRun?    @relation(fields: [workspaceId, siteId, auditId], references: [workspaceId, siteId, id], onDelete: NoAction, onUpdate: NoAction)
  refs ArtifactRef[]

  @@unique([id, generation, workspaceId])
  @@unique([auditId, requestedUrl, fence])
  @@unique([workspaceId, siteId, auditId, pageId, id, generation, capturedAt, expiresAt])
  @@index([state, expiresAt, id])
  @@index([workspaceId, id])
}

model ArtifactRef {
  recordingId String? @db.Uuid
  runId String?
  panelId String?
  promptId String?
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String
  siteId             String
  auditId            String?
  pageId             String?            @unique
  anchors            Json
  slotPageId         String?            @db.Uuid
  blobId             String             @unique @db.Uuid
  generation         String             @db.Uuid
  ownerKind          String             @default("AUDIT_PAGE")
  role               String             @default("ORIGINAL_BODY")
  capturedAt         DateTime
  expiresAt          DateTime
  page AuditPageRetention? @relation(fields: [workspaceId, auditId, pageId], references: [workspaceId, auditId, pageId], onDelete: NoAction, onUpdate: NoAction)
  blob ArtifactBlob?      @relation(fields: [workspaceId, siteId, auditId, slotPageId, blobId, generation, capturedAt, expiresAt], references: [workspaceId, siteId, auditId, pageId, id, generation, capturedAt, expiresAt], onDelete: NoAction, onUpdate: NoAction)

  @@index([expiresAt, id])
  @@index([workspaceId, auditId, pageId])
}

model AuditEvaluationScratch {
  workspaceId        String
  auditId            String
  pageId             String
  expiresAt          DateTime
  facts              Json
  page AuditPageRetention @relation(fields: [workspaceId, auditId, pageId], references: [workspaceId, auditId, pageId], onDelete: NoAction, onUpdate: NoAction)

  @@id([workspaceId, auditId, pageId])
  @@index([expiresAt, pageId])
}

// Controlled local active-store expiry. SQL owns all writes and the private enrollment.
model ArtifactExpiryPlan {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 policyVersion String
 workspaceId String
 siteId String
 environmentId String @db.Uuid
 databaseOid Unsupported("oid")
 postmasterStartedAt DateTime @db.Timestamptz(6)
 storeId String @db.Uuid
 namespaceId String @db.Uuid
 plannedAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
 expiresAt DateTime @db.Timestamptz(6)
 manifest Json
 manifestHash String
 paused Boolean @default(false)
 rotation Int @default(0)
 classCursors Json @default("{}")
}

model ArtifactExpiryItem {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 class String
 logicalKey String @unique
 workspaceId String
 siteId String
 blobId String? @db.Uuid
 generation String? @db.Uuid
 ownerKind String?
 deadline DateTime @db.Timestamp(3)
 fingerprint String
 origin String?
 version Json?
 currentPlanId String @db.Uuid
 status String @default("READY")
 attemptSequence BigInt @default(0)
 token String? @db.Uuid
 workerTokenHash String?
 leaseUntil DateTime? @db.Timestamptz(6)
 nextRetryAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
 completedAt DateTime? @db.Timestamptz(6)

 @@index([status,nextRetryAt,id])
 @@index([workspaceId,siteId,class,deadline,id])
}

model ArtifactExpiryEvent {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 planId String @db.Uuid
 itemId String @db.Uuid
 sequence BigInt
 token String? @db.Uuid
 outcome String
 reason String
 proofDigest String?
 proofAt DateTime? @db.Timestamptz(6)
 createdAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

 @@index([planId,itemId,sequence])
}

model VisibilityRecording {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 runId String @unique @default(dbgenerated("gen_random_uuid()::text"))
 workspaceId String
 siteId String
 panelId String
 userId String
 securityVersion Int
 sessionId String
 sourceNamespace String
 recordingKey String
