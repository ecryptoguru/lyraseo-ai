generator client {
  provider = "prisma-client"
  output = "../generated"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}
model ProductUser {
  keywordSelections KeywordSelection[]
  id String @id @default(cuid())
  suspended Boolean @default(false)
  securityVersion Int @default(0)
  auditRuns AuditRun[]
  revisionPins ContentRevisionPin[]
  quotes OperationQuote[]
  operations Operation[]
  createdAt DateTime @default(now())
  identities ProviderIdentity[]
  memberships Membership[]
}
model ProviderIdentity {
  id String @id @default(cuid())
  provider String
  subject String
  userId String
  user ProductUser @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@unique([provider,subject])
}
model Workspace {
  id String @id @default(cuid())
  name String
  accessRevision Int @default(0)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  memberships Membership[]
  sites Site[]
}
model Membership {
  workspaceId String
  userId String
  role Role
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  user ProductUser @relation(fields:[userId],references:[id],onDelete:Restrict)
  grants SiteGrant[]
  @@id([workspaceId,userId])
}
model Site {
  keywordSelections KeywordSelection[]
  analyticsStates AnalyticsOAuthState[]
  analyticsConnection AnalyticsConnection?
  analyticsImports AnalyticsImport[]
  googleStates GoogleOAuthState[]
  googleConnection GoogleConnection?
  searchSnapshots SearchSnapshot[]
  searchImports SearchImport[]
  contextRevisions SiteContextRevision[]
  verificationChallenges SiteVerificationChallenge[]
  auditRuns AuditRun[]
  quotes OperationQuote[]
  operations Operation[]
  id String @id @default(cuid())
  workspaceId String
  origin String
  verifiedAt DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  grants SiteGrant[]
  @@unique([workspaceId,id])
  @@unique([workspaceId,origin])
  @@index([workspaceId,createdAt,id])
}
model SiteGrant {
  workspaceId String
  siteId String
  userId String
  site Site @relation(fields:[workspaceId,siteId],references:[workspaceId,id],onDelete:Cascade)
  member Membership @relation(fields:[workspaceId,userId],references:[workspaceId,userId],onDelete:Cascade)
  @@id([workspaceId,siteId,userId])
  @@index([workspaceId,userId,siteId])
}

model WorkspaceAccessEvent {
 id String @id @default(cuid())
 workspaceId String
 actorId String
 action String
 targetUserId String?
 siteId String?
 previousRole String?
 nextRole String?
 accessRevision Int
 createdAt DateTime @default(now())
 @@unique([workspaceId,accessRevision])
 @@index([workspaceId,createdAt,id])
}
model WorkspaceInvitation {
 id String @id @default(cuid())
 workspaceId String
 tokenHash String @unique
 invitedEmailDigest String
 role Role
 createdBy String
 createdAt DateTime @default(now())
 expiresAt DateTime
 acceptedAt DateTime?
 acceptedBy String?
 revokedAt DateTime?
 sites WorkspaceInvitationSite[]
 @@unique([workspaceId,id])
 @@index([workspaceId,createdAt,id])
 @@index([expiresAt,id])
}
model WorkspaceInvitationSite {
 workspaceId String
 invitationId String
 siteId String
 invitation WorkspaceInvitation @relation(fields:[workspaceId,invitationId],references:[workspaceId,id],onDelete:Cascade)
 @@id([workspaceId,invitationId,siteId])
}
model IssueAssignment {
 id String @id @default(cuid())
 workspaceId String
 siteId String
 auditId String
 ruleId String
 scopeKey String
 assigneeUserId String?
 revision Int
 updatedAt DateTime @default(now())
 @@unique([workspaceId,siteId,auditId,ruleId,scopeKey])
 @@unique([workspaceId,siteId,id])
 @@index([workspaceId,siteId,updatedAt,id])
 @@index([workspaceId,siteId,assigneeUserId,updatedAt,id])
}
model IssueAssignmentEvent {
 id String @id @default(cuid())
 workspaceId String
 siteId String
 assignmentId String
 revision Int
 actorId String
 assigneeUserId String?
 createdAt DateTime @default(now())
 idempotencyKey String
 inputHash String
 @@unique([assignmentId,revision])
 @@unique([workspaceId,siteId,actorId,idempotencyKey])
}

model StaffGrant {
  userId String @id
  enabled Boolean @default(true)
}
model StepUpGrant {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  sessionId String
  action String
  resourceId String
  expiresAt DateTime
  consumedAt DateTime?
}
model BudgetPeriod {
  id String @id @default(cuid())
  userId String
  period String
  bucket String
  limit Decimal @db.Decimal(20,9)
  spent Decimal @default(0) @db.Decimal(20,9)
  reserved Decimal @default(0) @db.Decimal(20,9)
  @@unique([userId,period,bucket])
}
model Operation {
  id String @id @default(cuid())
  workspaceId String
  siteId String
  userId String
  sessionId String
  securityVersion Int
  kind String
  provider String
  period String
  route String
  idempotencyKey String
  inputHash String
  requestInput Json?
  tariffVersion String
  reservedCost Decimal @db.Decimal(20,9)
  actualCost Decimal? @db.Decimal(20,9)
  keywordResult KeywordEnrichmentResult?
  ledgerMode String @default("LEGACY")
  ledgerVersion Int @default(0)
  status String @default("QUEUED")
  createdAt DateTime @default(now())
  expiresAt DateTime
  cancelRequestedAt DateTime?
  leaseOwner String?
  leaseUntil DateTime?
  fence Int @default(0)
  attemptState String @default("NONE")
  providerTaskId String?
  settledAt DateTime?
  site Site @relation(fields:[workspaceId,siteId],references:[workspaceId,id],onDelete:Restrict)
  user ProductUser @relation(fields:[userId],references:[id],onDelete:Restrict)
  quote OperationQuote?
  outbox OutboxEvent?
  dispatchRecords WorkDispatch[]
  @@unique([workspaceId,siteId,userId,id])
  receipts UsageReceipt[]
  @@unique([userId,workspaceId,route,idempotencyKey])
  @@index([workspaceId,createdAt,id])
  @@index([status,leaseUntil])
}
model OutboxEvent {
  dispatch WorkDispatch?
  id String @id @default(cuid())
  operationId String @unique
  workspaceId String
  userId String
  createdAt DateTime @default(now())
  deliveredAt DateTime?
  attempts Int @default(0)
  operation Operation @relation(fields:[operationId],references:[id],onDelete:Cascade)
}
model UsageReceipt {
  id String @id @default(cuid())
  operationId String
  workspaceId String
  userId String
  provider String
  receiptId String
  amount Decimal @db.Decimal(20,9)
  acceptedOutput Boolean
  createdAt DateTime @default(now())
  operation Operation @relation(fields:[operationId],references:[id],onDelete:Restrict)
  @@unique([provider,receiptId])
  @@unique([operationId,provider])
}
model AuthThrottle {
  key String @id
  count Int @default(1)
  expiresAt DateTime
}
model ProductSession {
  sessionId String @id
  userId String
  securityVersion Int
  createdAt DateTime
  refreshedAt DateTime
}

model OperationQuote {
  id String @id @default(cuid())
  userId String
  workspaceId String
  siteId String
  kind String
  provider String
  route String
  inputHash String
  requestInput Json
  maximumCost Decimal @db.Decimal(20,9)
  tariffVersion String
  securityVersion Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  consumedOperationId String? @unique
  user ProductUser @relation(fields:[userId],references:[id],onDelete:Restrict)
  site Site @relation(fields:[workspaceId,siteId],references:[workspaceId,id],onDelete:Restrict)
  consumedOperation Operation? @relation(fields:[consumedOperationId],references:[id],onDelete:Restrict)
  @@index([userId,expiresAt])
 @@unique([workspaceId,siteId,userId,id])
}

model AuditRun {
 storageFormat String?
 artifactBlobs ArtifactBlob[]
 @@unique([workspaceId,siteId,id])
 resultExpiresAt DateTime @default(dbgenerated())
 @@index([workspaceId,siteId,resultExpiresAt])
 id String @id @default(cuid())
 workspaceId String
 siteId String
 userId String
 securityVersion Int
 idempotencyKey String
 inputHash String
 manifest Json
 profile String
 declarations Json
 methodologyVersion String
 status String @default("QUEUED")
 fence Int @default(0)
 leaseOwner String?
 leaseUntil DateTime?
 createdAt DateTime @default(now())
 completedAt DateTime?
 evaluation Json?
 site Site @relation(fields:[workspaceId,siteId],references:[workspaceId,id],onDelete:Restrict)
 user ProductUser @relation(fields:[userId],references:[id],onDelete:Restrict)
 dispatchRecords WorkDispatch[]
 @@unique([workspaceId,siteId,userId,id])
 pages AuditPage[]
 actions IssueAction[]
 @@unique([workspaceId,id])
 @@unique([workspaceId,siteId,userId,idempotencyKey])
 @@index([workspaceId,siteId,createdAt,id])
}
model AuditPage {
 id String @id @default(cuid())
 workspaceId String
 auditId String
 requestedUrl String
 evidence Json
 provenance Json
 createdAt DateTime @default(now())
 audit AuditRun @relation(fields:[workspaceId,auditId],references:[workspaceId,id],onDelete:Restrict)
 retention AuditPageRetention?
 @@unique([workspaceId,auditId,id])
 @@unique([auditId,requestedUrl])
}
model IssueAction {
 id String @id @default(cuid())
 workspaceId String
 auditId String
 userId String
 ruleId String
 scopeKey String
 disposition String
 reason String
 createdAt DateTime @default(now())
 audit AuditRun @relation(fields:[workspaceId,auditId],references:[workspaceId,id],onDelete:Restrict)
 @@index([workspaceId,auditId,createdAt])
}

model SiteVerificationChallenge {
 sessionId String
 id String @id @default(cuid())
 workspaceId String
 siteId String
 tokenHash String
 issuedBy String
 securityVersion Int
 expiresAt DateTime
 createdAt DateTime @default(now())
 consumedAt DateTime?
 revokedAt DateTime?
 site Site @relation(fields:[workspaceId,siteId],references:[workspaceId,id],onDelete:Restrict)
 @@index([workspaceId,siteId,createdAt])
}
model SiteContextRevision {
 id String @id @default(cuid())
 workspaceId String
 siteId String
 revision Int
 content Json
 reviewedBy String
 reviewedAt DateTime @default(now())
 site Site @relation(fields:[workspaceId,siteId],references:[workspaceId,id],onDelete:Restrict)
 @@unique([workspaceId,siteId,revision])
}

model GoogleOAuthState {
 id String @id
 workspaceId String
 siteId String
 userId String
 sessionId String
 securityVersion Int
 verifier String
 expiresAt DateTime
 consumedAt DateTime?
 site Site @relation(fields:[workspaceId,siteId],references:[workspaceId,id],onDelete:Cascade)
 @@index([workspaceId,siteId])
}
model GoogleConnection {
 @@unique([workspaceId,siteId])
 id String @id @default(cuid())
 workspaceId String
 siteId String @unique
 encryptedRefreshToken String
 property String?
 generation Int @default(0)
 createdAt DateTime @default(now())
 site Site @relation(fields:[workspaceId,siteId],references:[workspaceId,id],onDelete:Cascade)
}
model SearchSnapshot {
 resultExpiresAt DateTime @default(dbgenerated())
 @@index([workspaceId,siteId,resultExpiresAt])
 id String @id @default(cuid())
 workspaceId String
 siteId String
 property String
 startDate String
 endDate String
 shape String
 status String
 rows Json
 importedAt DateTime @default(now())
 site Site @relation(fields:[workspaceId,siteId],references:[workspaceId,id],onDelete:Cascade)
 @@unique([workspaceId,siteId,property,startDate,endDate,shape])
 @@index([workspaceId,siteId,importedAt])
}

model ContentDraft {
 id String @id @default(cuid())
 workspaceId String
 siteId String
 kind String
 revision Int @default(1)
 evidenceFormat String?
 snapshot Json
 createdAt DateTime @default(now())
 @@unique([workspaceId,siteId,id])
 @@index([workspaceId,siteId,createdAt])
}
model ContentRevision {
 historyExpiresAt DateTime @default(dbgenerated())
 @@index([workspaceId,draftId,historyExpiresAt],map:"ContentRevision_history_expiry")
 id String @id @default(cuid())
 workspaceId String
 draftId String
 revision Int
 content Json
 userId String
 createdAt DateTime @default(now())
 pin ContentRevisionPin?
 @@unique([workspaceId,draftId,revision])
 @@unique([draftId,revision])
}
model EvidenceReport {
 id String @id @default(cuid())
 // Derived stored identity digest; PostgreSQL GENERATED ALWAYS controls writes.
 identifierKey String @default(dbgenerated())
 workspaceId String
 siteId String
 title String
 evidenceFormat String?
 snapshot Json
 pdf Bytes?
 csv String?
 createdAt DateTime @default(now())
 @@index([workspaceId,siteId,createdAt])
 @@index([workspaceId,siteId,identifierKey], map: "EvidenceReport_opaque_key_idx")
}

model VisibilityPanel {
 id String @id @default(cuid())
 workspaceId String
 siteId String
 version Int
 prompts Json
 brands Json
 createdBy String
 reviewedBy String?
 reviewedAt DateTime?
 createdAt DateTime @default(now())
 @@unique([workspaceId,siteId,version])
}
model VisibilityRun {
 storageFormat String?
 @@unique([workspaceId,siteId,panelId,id])
 resultExpiresAt DateTime @default(dbgenerated())
 @@index([workspaceId,siteId,resultExpiresAt])
 id String @id @default(cuid())
 workspaceId String
 siteId String
 panelId String
 profile String
 cohort String
 provenance Json
 slots Json
 rawAnswers Json?
 rawExpiresAt DateTime
 createdAt DateTime @default(now())
 @@index([workspaceId,siteId,createdAt])
}

model ApiToken {
 id String @id @default(cuid())
 workspaceId String
 createdBy String
 name String
 tokenHash String @unique
 securityVersion Int
 accessPolicyHash String
 siteIds String[]
 scopes String[]
 requestKey String
 createdAt DateTime @default(now())
 expiresAt DateTime
 revokedAt DateTime?
 @@unique([createdBy,workspaceId,requestKey])
 @@index([createdBy,workspaceId,createdAt])
}
model ApiThrottle {
 key String @id
 count Int
 expiresAt DateTime
}

model PageIdentity {
 id String @id @default(cuid())
 workspaceId String
 siteId String
 originalUrl String
 normalizedUrl String
 revision Int @default(1)
 assignedTo String?
 createdBy String
 createdAt DateTime @default(now())
 @@unique([workspaceId,siteId,normalizedUrl])
 @@unique([workspaceId,siteId,id])
 @@index([workspaceId,siteId,createdAt,id])
}
model PageJournal {
 id String @id @default(cuid())
 workspaceId String
 siteId String
 pageId String
 revision Int
 action String
 note String
 userId String
 assigneeUserId String?
 idempotencyKey String
 inputHash String
 contentDraftId String?
 contentDraftRevision Int?
 createdAt DateTime @default(now())
 @@unique([pageId,revision])
 @@unique([workspaceId,pageId,userId,idempotencyKey])
 @@index([workspaceId,siteId,pageId,revision])
}

model AnalyticsOAuthState {
 id String @id
 workspaceId String
